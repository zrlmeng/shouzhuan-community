APP_NAME=ztdh-install
APP_PORT=8080
APP_IMAGE=eclipse-temurin:25-jre
FRAMEWORK=install
ZTDH_INSTALL_EDITION=enc
MYSQL_PORT=3306
MYSQL_DB=ztdh-install
MYSQL_USER=root
# 空或弱口令时 install.sh 会自动生成 ≥24 位强密码（大小写+数字+符号）
MYSQL_PASSWORD=
MYSQL_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_HOST=host.docker.internal
REDIS_DB=2
# Redis 密码可不配（默认无 requirepass）；需要时再自行填写 REDIS_PASSWORD
# REDIS_PASSWORD=
SPRING_PROFILES_ACTIVE=local
YUDAO_LICENSE_RUNTIME_EDITION=install
YUDAO_LICENSE_RUNTIME_ONLINE_REQUIRED=true
YUDAO_LICENSE_RUNTIME_OFFLINE_GRACE_HOURS=0
YUDAO_INSTALL_WEB_ENABLED=true
YUDAO_FRAMEWORK_VERSION=1.0.2
JAVA_OPTS=-Xms512m -Xmx1280m -Djava.security.egd=file:/dev/./urandom
